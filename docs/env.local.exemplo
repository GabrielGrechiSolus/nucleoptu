# Copie para .env.local (ignorado pelo Git) e preencha. Descrição de cada item em docs/VARIAVEIS_AMBIENTE.md.
# Nunca grave valores reais neste arquivo: o repositório é público.

# Firebase (aplicativo Web) - obrigatórias
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Chave de serviço do Firebase (use apenas uma das duas) - SEGREDO
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Administração e cadastro
ADMIN_EMAILS=
NEXT_PUBLIC_VERIFICACAO_EMAIL_A_PARTIR_DE=

# Conexões de clientes - SEGREDO (base64 de 32 bytes)
CONEXOES_CHAVE_CRIPTO=

# GitHub - SEGREDO (localmente pode usar o login do GitHub CLI)
GITHUB_TOKEN=
GITHUB_ORG=
GH_PATH=

# Revisions
QUALIDADE_API_REVISAO=
REVISAO_REPOS=

# Businessmap
BM_URL=
BM_API_KEY=
BM_BOARD_IDS=
BM_PROCESSOS_PERFIS=
BM_ESCRITA_GIT_USERS=

# Web Relatus - RELATUS_SENHA é SEGREDO
RELATUS_LOGIN=
RELATUS_SENHA=
NEXT_PUBLIC_RELATUS_USUARIOS=
NEXT_PUBLIC_CRONOGRAMA_USUARIOS=

# Assistente - SEGREDO
GEMINI_API_KEY=

# Importação de contextos a partir de pasta (somente servidor local)
CONTEXTOS_DIR=
